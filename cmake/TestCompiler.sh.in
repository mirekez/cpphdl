#!/usr/bin/env bash
set -euo pipefail
# Only executable links need runtime archives. Keep compiler discovery,
# preprocessing, object builds and shared-library ABI tests unchanged.
link=1
libcxx=0
output=a.out
output_pending=0
for arg in "$@"; do
    if (( output_pending )); then
        output="$arg"
        output_pending=0
        continue
    fi
    case "$arg" in
        -c|-S|-E|-fsyntax-only|-shared|-r|-M|-MM|c++-header|c-header|--version|--help|-###|-dump*|-print*|--print*) link=0 ;;
        -stdlib=libc++) libcxx=1 ;;
        -o|--output) output_pending=1 ;;
        -o?*) output="${arg#-o}" ;;
        --output=*) output="${arg#--output=}" ;;
    esac
done
if (( ! link )); then
    exec "@CPPHDL_TEST_REAL_CXX@" "$@"
fi
args=()
if [[ -n "@CPPHDL_TEST_RUNTIME_DIR@" ]]; then
    args+=("-L@CPPHDL_TEST_RUNTIME_DIR@")
fi
for arg in "$@"; do
    case "$arg" in
        -lstdc++|-lc++|-lc++abi)
            args+=(-Wl,-Bstatic "$arg" -Wl,-Bdynamic) ;;
        *) args+=("$arg") ;;
    esac
done
if (( libcxx )); then
    args+=(-Wl,-Bstatic -Wl,--start-group -lc++ -lc++abi -Wl,--end-group -Wl,-Bdynamic)
fi
"@CPPHDL_TEST_REAL_CXX@" "${args[@]}" -static-libstdc++ -static-libgcc
# Match the converter's executable post-link policy. This removes metadata,
# not instructions; the linked code must still support the intended CPU.
if [[ -n "@CPPHDL_TEST_OBJCOPY@" && -f "$output" ]]; then
    "@CPPHDL_TEST_OBJCOPY@" --remove-section=.note.gnu.property "$output"
fi
