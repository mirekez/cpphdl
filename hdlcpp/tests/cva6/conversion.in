auto pow2 = [](unsigned x) constexpr { return 1u << x; };
bool IS_XLEN32 = CVA6Cfg.XLEN == 32;
bool IS_XLEN64 = CVA6Cfg.XLEN != 32;
bool FpPresent = (bool)CVA6Cfg.RVF || (bool)CVA6Cfg.RVD || (bool)CVA6Cfg.XF16 || (bool)CVA6Cfg.XF16ALT || (bool)CVA6Cfg.XF8;
bool NSX = (bool)CVA6Cfg.XF16 || (bool)CVA6Cfg.XF16ALT || (bool)CVA6Cfg.XF8 || (bool)CVA6Cfg.XFVec;
unsigned FLen = (bool)CVA6Cfg.RVD ? 64 : (bool)CVA6Cfg.RVF ? 32 : (bool)CVA6Cfg.XF16 ? 16 : (bool)CVA6Cfg.XF16ALT ? 16 : (bool)CVA6Cfg.XF8 ? 8 : 1;
bool RVFVec = (bool)CVA6Cfg.RVF && (bool)CVA6Cfg.XFVec && (FLen > 32);
bool XF16Vec = (bool)CVA6Cfg.XF16 && (bool)CVA6Cfg.XFVec && (FLen > 16);
bool XF16ALTVec = (bool)CVA6Cfg.XF16ALT && (bool)CVA6Cfg.XFVec && (FLen > 16);
bool XF8Vec = (bool)CVA6Cfg.XF8 && (bool)CVA6Cfg.XFVec && (FLen > 8);
bool EnableAccelerator = static_cast<bool>(CVA6Cfg.RVV);
unsigned NrWbPorts = (CVA6Cfg.CvxifEn || EnableAccelerator) ? 5 : 4;
unsigned ICACHE_INDEX_WIDTH = clog2(CVA6Cfg.IcacheByteSize / CVA6Cfg.IcacheSetAssoc);
unsigned DCACHE_INDEX_WIDTH = clog2(CVA6Cfg.DcacheByteSize / CVA6Cfg.DcacheSetAssoc);
unsigned DCACHE_OFFSET_WIDTH = clog2(CVA6Cfg.DcacheLineWidth / 8);
unsigned VpnLen = (CVA6Cfg.XLEN == 64) ? (CVA6Cfg.RVH ? 29 : 27) : 20;
unsigned PtLevels = (CVA6Cfg.XLEN == 64) ? 3 : 2;
unsigned PLEN_v = (CVA6Cfg.XLEN == 32) ? 34 : 56;
unsigned GPLEN_v = (CVA6Cfg.XLEN == 32) ? 34 : 41;
unsigned ASID_WIDTH_v = (CVA6Cfg.XLEN == 64) ? 16 : 1;
unsigned VMID_WIDTH_v = (CVA6Cfg.XLEN == 64) ? 14 : 1;
unsigned ICACHE_USER_LINE_WIDTH_v = (CVA6Cfg.AxiUserWidth == 1) ? 4 : CVA6Cfg.IcacheLineWidth;
unsigned DCACHE_USER_LINE_WIDTH_v = (CVA6Cfg.AxiUserWidth == 1) ? 4 : CVA6Cfg.DcacheLineWidth;
unsigned AXI_USER_EN_v = (CVA6Cfg.DataUserEn | CVA6Cfg.FetchUserEn) != 0;
unsigned ModeW_v = (CVA6Cfg.XLEN == 32) ? 1 : 4;
unsigned ASIDW_v = (CVA6Cfg.XLEN == 32) ? 9 : 16;
unsigned VMIDW_v = (CVA6Cfg.XLEN == 32) ? 7 : 14;
unsigned PPNW_v = (CVA6Cfg.XLEN == 32) ? 22 : 44;
unsigned GPPNW_v = (CVA6Cfg.XLEN == 32) ? 22 : 29;
auto MODE_SV_v = (CVA6Cfg.XLEN == 32) ? config_pkg::ModeSv32 : config_pkg::ModeSv39;
unsigned SV_v = (MODE_SV_v == config_pkg::ModeSv32) ? 32 : 39;
unsigned SVX_v = (MODE_SV_v == config_pkg::ModeSv32) ? 34 : 41;
