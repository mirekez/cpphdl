export HDLCPP_SKIP_USING_NAMESPACE_IMPORTS="cvxif_instr_pkg"
export HDLCPP_VAR_TYPE_PATCHES="$OUT/cva6_var_type_patches.tsv"
export HDLCPP_INLINE_COMB_MODULES=""
