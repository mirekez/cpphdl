napot_match	    template<typename BASE_T, typename VALUE_T> inline uint64_t napot_match(const BASE_T& base_in, const VALUE_T& value_in)\n    {\n        uint64_t base = (uint64_t)(logic<64>(base_in));\n        uint64_t value = (uint64_t)(logic<64>(value_in));\n        bool is_valid_napot = ((base & (base + 1)) == 0);\n        if (!is_valid_napot) return 0;\n        uint64_t mask = ~(base & ~(base + 1));\n        return ((value & mask) == (base & mask)) ? 1 : 0;\n    }
match_scontext	    template<typename SCONTEXT_T, typename SSELECT_T, typename SBYTEMASK_T, typename SVALUE_T, typename FLAG_T> inline uint64_t match_scontext(const SCONTEXT_T& scontext_in, const SSELECT_T& sselect_in, const SBYTEMASK_T& sbytemask_in, const SVALUE_T& svalue_in, const FLAG_T& flag_in)\n    {\n        uint64_t scontext = (uint64_t)(logic<32>(scontext_in));\n        uint64_t sselect = (uint64_t)(logic<2>(sselect_in));\n        uint64_t sbytemask = (uint64_t)(logic<4>(sbytemask_in));\n        uint64_t svalue = (uint64_t)(logic<32>(svalue_in));\n        bool flag = (bool)(logic<1>(flag_in));\n        if (sselect != 1) return 0;\n        int max_bytes = flag ? 4 : 2;\n        for (int b = 0; b < max_bytes; ++b) {\n            if (!((sbytemask >> b) & 1u) && (((scontext >> (8*b)) & 0xffu) != ((svalue >> (8*b)) & 0xffu))) return 0;\n        }\n        return 1;\n    }
range_check	    inline constexpr uint64_t range_check(uint64_t base, uint64_t len, uint64_t address)\n    {\n        return (address >= base && address < (base + len)) ? 1ull : 0ull;\n    }
is_inside_nonidempotent_regions	    inline constexpr uint64_t is_inside_nonidempotent_regions(cva6_cfg_t Cfg, uint64_t address)\n    {\n        for (unsigned k = 0; k < Cfg.NrNonIdempotentRules; ++k) {\n            if (range_check(Cfg.NonIdempotentAddrBase[k], Cfg.NonIdempotentLength[k], address)) return 1ull;\n        }\n        return 0ull;\n    }
is_inside_execute_regions	    inline constexpr uint64_t is_inside_execute_regions(cva6_cfg_t Cfg, uint64_t address)\n    {\n        if (Cfg.NrExecuteRegionRules == 0) return 1ull;\n        for (unsigned k = 0; k < Cfg.NrExecuteRegionRules; ++k) {\n            if (range_check(Cfg.ExecuteRegionAddrBase[k], Cfg.ExecuteRegionLength[k], address)) return 1ull;\n        }\n        return 0ull;\n    }
is_inside_cacheable_regions	    inline constexpr uint64_t is_inside_cacheable_regions(cva6_cfg_t Cfg, uint64_t address)\n    {\n        for (unsigned k = 0; k < Cfg.NrCachedRegionRules; ++k) {\n            if (range_check(Cfg.CachedRegionAddrBase[k], Cfg.CachedRegionLength[k], address)) return 1ull;\n        }\n        return 0ull;\n    }
