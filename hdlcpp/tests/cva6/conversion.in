#pragma once

#include "cpphdl.h"
#include <algorithm>
#include <array>
#include <tuple>
#include <print>
#include <type_traits>
#include <utility>

#ifndef HDLCPP_RANGE_WIDTH_DEFINED
#define HDLCPP_RANGE_WIDTH_DEFINED
consteval uint64_t __hdlcpp_range_width(int32_t first, int32_t last) {
    return first >= last ? uint64_t(int64_t(first) - last) + 1 : uint64_t(int64_t(last) - first) + 1;
}
#endif

#ifndef HDLCPP_FIXED_STRING_DEFINED
#define HDLCPP_FIXED_STRING_DEFINED
template <size_t N>
struct hdlcpp_fixed_string {
    char value[N]{};
    constexpr hdlcpp_fixed_string(const char (&str)[N]) { for (size_t i = 0; i < N; ++i) value[i] = str[i]; }
};
template <size_t N, size_t M>
constexpr bool operator==(const hdlcpp_fixed_string<N>& lhs, const char (&rhs)[M]) {
    if constexpr (N != M) return false;
    else { for (size_t i = 0; i < N; ++i) if (lhs.value[i] != rhs[i]) return false; return true; }
}
template <size_t N, size_t M>
constexpr bool operator!=(const hdlcpp_fixed_string<N>& lhs, const char (&rhs)[M]) { return !(lhs == rhs); }
#endif

