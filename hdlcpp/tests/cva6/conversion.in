class tc_clk_gating : public Module {
public:
    _PORT(logic<1>) en_i_in;
    _PORT(logic<1>) test_en_i_in;
    _PORT(logic<1>) clk_o_out = _ASSIGN_COMB(clk_o_comb_func());
private:
    reg<logic<1>> clk_en;
    logic<1> clk_o_comb;
    logic<1>& clk_o_comb_func() { clk_o_comb = clk_en; return clk_o_comb; }
public:
