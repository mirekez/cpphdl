diff --git a/include/cpphdl_graph_native_guards.h b/include/cpphdl_graph_native_guards.h
new file mode 100644
index 0000000..38aea9e
--- /dev/null
+++ b/include/cpphdl_graph_native_guards.h
@@ -0,0 +1,87 @@
+#pragma once
+#include <cpphdl_graph.h>
+
+namespace cpphdl::graph {
+// Experimental conservative demand guards. Distinct demands merge to eager
+// evaluation instead of constructing an exponentially growing predicate DAG.
+struct NativeDemandPlan {
+    struct Predicate {
+        Bit bit = 0;
+        bool positive = true;
+        bool operator==(const Predicate&) const = default;
+    };
+    std::vector<Predicate> demand;
+    std::vector<bool> control;
+    static Predicate canonical(Predicate p) {
+        if (p.bit < 2) return {Bit(bool(p.bit) == p.positive), true};
+        return p;
+    }
+    NativeDemandPlan(Graph& graph, std::vector<size_t>& order)
+        : demand(graph.nodes.size()), control(graph.nodes.size()) {
+        const Predicate always{1, true};
+        auto predicate = [&](const Value& value, bool positive = true) {
+            auto bits = graph.resolved(value);
+            // Multi-bit enables are conservatively evaluated eagerly.
+            return bits.size() == 1 ? canonical({bits.front(), positive}) : always;
+        };
+        auto require = [&](const Value& value, Predicate needed) {
+            needed = canonical(needed);
+            if (!needed.bit) return;
+            for (auto bit : graph.resolved(value)) if (bit > 1) {
+                auto& current = demand[Graph::owner(bit)];
+                if (!current.bit) current = needed;
+                else if (current != needed) current = always;
+            }
+        };
+        for (const auto& port : graph.ports) if (!port.input) require(port.bits, always);
+        for (const auto& state : graph.states) {
+            require(state.trigger, always); require(state.reset, always);
+            require(state.next, predicate(state.trigger));
+            require(state.resetValue, always);
+        }
+        for (const auto& access : graph.memoryAccesses) {
+            require(access.enabled, always);
+            require(access.address, predicate(access.enabled));
+        }
+        for (const auto& write : graph.memoryWrites) {
+            require(write.enabled, always);
+            require(write.address, predicate(write.enabled));
+            require(write.data, predicate(write.enabled));
+        }
+        auto propagate = [&] {
+            for (auto it = order.rbegin(); it != order.rend(); ++it) {
+                auto needed = demand[*it];
+                if (!needed.bit) continue;
+                const auto& node = graph.nodes[*it];
+                if (node.op == "state" || node.op == "input") continue;
+                require(node.select, needed);
+                if (node.op == "mux" && needed == always) {
+                    require(node.left, predicate(node.select));
+                    require(node.right, predicate(node.select, false));
+                } else {
+                    // Using the outer guard is a safe weakening of its
+                    // conjunction with an inner mux choice.
+                    require(node.left, needed); require(node.right, needed);
+                }
+            }
+        };
+        propagate();
+        // Compute every guard and its full dependency cone before guarded
+        // data. This prevents a stale guard or an artificial scheduling cycle.
+        std::vector<size_t> pending;
+        for (const auto& p : demand) if (p.bit > 1) pending.push_back(Graph::owner(p.bit));
+        while (!pending.empty()) {
+            auto index = pending.back(); pending.pop_back();
+            if (control[index]) continue;
+            control[index] = true; demand[index] = always;
+            const auto& node = graph.nodes[index];
+            if (node.op == "state" || node.op == "input") continue;
+            for (const auto* bits : {&node.left, &node.right, &node.select})
+                for (auto bit : graph.resolved(*bits)) if (bit > 1)
+                    pending.push_back(Graph::owner(bit));
+        }
+        propagate();
+        std::stable_partition(order.begin(), order.end(), [&](size_t index) { return control[index]; });
+    }
+};
+}
