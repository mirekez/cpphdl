+python3 - "$attempt" "$root" "$output_dir" "$cpphdl_include" <<'PY'
+import json
+import os
+import shlex
+from pathlib import Path
+import sys
+attempt, root, generated, include = map(Path, sys.argv[1:])
+hosts = json.loads((attempt / 'hosts.json').read_text())
+runtime = root / 'tools/firtool-cpphdl/runtime'
+collateral = root / 'generators/testchipip/src/main/resources/testchipip/csrc'
+riscv = root / '.conda-env/riscv-tools'
+sources = [attempt / 'runner.cpp', runtime / 'cpphdl_runtime.cpp',
+           runtime / 'cpphdl_external_models.cpp', collateral / 'mm.cc',
+           collateral / 'testchip_tsi.cc', collateral / 'testchip_htif.cc']
+sources += [generated / (name + '.cpp') for name in sorted({h['type'] for h in hosts})]
+sources += [Path(s) for s in os.environ.get('CPPHDL_EXTRA_SOURCES', '').split(os.pathsep) if s]
+extra_include = [Path(s) for s in os.environ.get('CPPHDL_EXTRA_INCLUDES', '').split(os.pathsep) if s]
+quote = lambda paths: '\n'.join(json.dumps(str(p)) for p in paths)
+(attempt / 'CMakeLists.txt').write_text(
+    'cmake_minimum_required(VERSION 3.16)\nproject(RocketNativeGraph LANGUAGES CXX)\n'
+    'set(CMAKE_CXX_STANDARD 23)\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\n'
+    'add_executable(cpphdl-rocket64-graph-sim\n' + quote(sources) + ')\n'
+    'target_compile_options(cpphdl-rocket64-graph-sim PRIVATE -O2 -fno-strict-aliasing)\n'
+    'target_include_directories(cpphdl-rocket64-graph-sim PRIVATE\n' +
+    quote([attempt, *extra_include, runtime, generated, include, collateral, riscv / 'include']) + ')\n'
+    'target_compile_definitions(cpphdl-rocket64-graph-sim PRIVATE\n' + quote(shlex.split(os.environ.get('CPPHDL_EXTRA_DEFINITIONS', ''))) + ')\n'
     'target_link_directories(cpphdl-rocket64-graph-sim PRIVATE ' + json.dumps(str(riscv / 'lib')) + ')\n'
     'target_link_libraries(cpphdl-rocket64-graph-sim PRIVATE fesvr riscv dl pthread)\n'
     'target_link_options(cpphdl-rocket64-graph-sim PRIVATE ' + json.dumps('-Wl,-rpath,' + str(riscv / 'lib')) + ')\n')
