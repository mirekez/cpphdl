+      "$cpphdl_include/cpphdl_graph_native.h" -nt "$linker" ]]; then
+  "$cxx" -std=c++23 -O2 -I"$cpphdl_include" "$link_source" -o "$linker" \
+    > "$attempt/build-linker.log" 2>&1
