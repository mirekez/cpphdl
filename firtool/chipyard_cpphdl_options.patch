+partition_args=()
+read -r -a combinational_hosts <<< "${CPPHDL_COMBINATIONAL_HOST:-}"
+for host in "${combinational_hosts[@]}"; do
+  partition_args+=(--combinational-host "$host")
+done
+python3 "$partition_tool" --source "$output_dir" --output "$partitions" \
+  --cpphdl "$cpphdl_tool" --include "$cpphdl_include" \
+  --jobs "${CPPHDL_GRAPH_JOBS:-1}" "${partition_args[@]}" 2>&1 | tee "$attempt/extract.log"
