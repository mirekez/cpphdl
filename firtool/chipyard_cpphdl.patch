+
+namespace firtool_cpphdl_runtime {
+
+void configure(int argc, char **argv);
+uint32_t exitCode();
+
+struct TSIOutputs {
+  bool inValid = false;
+  uint32_t inBits = 0;
+  bool outReady = false;
+  uint32_t exit = 0;
+};
+
+class TSIModel {
+public:
+  TSIModel();
+  ~TSIModel();
+  void tick(bool reset, bool outValid, uint32_t outBits, bool inReady,
+            TSIOutputs &outputs);
+
+private:
+  struct Impl;
+  Impl *impl;
+};
+
+struct DRAMInputs {
+  bool reset = false;
+  bool arValid = false;
+  uint64_t arAddr = 0;
+  uint64_t arId = 0;
+  uint64_t arSize = 0;
+  uint64_t arLen = 0;
+  bool awValid = false;
+  uint64_t awAddr = 0;
+  uint64_t awId = 0;
+  uint64_t awSize = 0;
+  uint64_t awLen = 0;
+  bool wValid = false;
+  uint64_t wStrb = 0;
+  uint64_t wData = 0;
+  bool wLast = false;
+  bool rReady = false;
+  bool bReady = false;
+};
+
+struct DRAMOutputs {
+  bool arReady = false;
+  bool awReady = false;
+  bool wReady = false;
+  bool bValid = false;
+  uint64_t bResp = 0;
+  uint64_t bId = 0;
+  bool rValid = false;
+  uint64_t rResp = 0;
+  uint64_t rId = 0;
+  uint64_t rData = 0;
+  bool rLast = false;
+};
+
+class DRAMModel {
+public:
+  DRAMModel();
+  ~DRAMModel();
+  void tick(const DRAMInputs &inputs, DRAMOutputs &outputs);
+
+private:
+  struct Impl;
+  Impl *impl;
+};
+
+} // namespace firtool_cpphdl_runtime
diff --git a/tools/firtool-cpphdl/runtime/sim_main.cpp b/tools/firtool-cpphdl/runtime/sim_main.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..40de41d0210ac99df209be79464b8d19a461cc33
--- /dev/null
+++ b/tools/firtool-cpphdl/runtime/sim_main.cpp
@@ -0,0 +1,78 @@
+#include "cpphdl_support.h"
+#include "TestHarness.h"
+#ifdef CPPHDL_OPTIMIZE_COMBS
+#include "TestHarness_optimized_combs.h"
+#endif
+#include "cpphdl_runtime.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+long _system_clock = 0;
+
+int main(int argc, char **argv) {
+  if (argc < 2) {
+    std::fprintf(stderr, "usage: %s program.riscv [FESVR options]\n", argv[0]);
+    return 2;
+  }
+  std::vector<std::string> argumentStorage;
+  std::vector<char *> runtimeArguments;
+  argumentStorage.reserve(argc + 1);
+  for (int index = 0; index < argc; ++index)
+    argumentStorage.emplace_back(argv[index]);
+  argumentStorage.emplace_back(std::string("+loadmem=") + argv[1]);
+  for (auto &argument : argumentStorage)
+    runtimeArguments.push_back(argument.data());
+  firtool_cpphdl_runtime::configure(runtimeArguments.size(),
+                                    runtimeArguments.data());
+
+  TestHarness top;
+  cpphdl::logic<1> clock = 1;
+  cpphdl::logic<1> reset = 1;
+  top.clock = [&clock]() { return std::addressof(clock); };
+  top.reset = [&reset]() { return std::addressof(reset); };
+#ifdef CPPHDL_OPTIMIZE_COMBS
+  bind_optimized_ports(top);
+#else
+  top._assign();
+#endif
+
+  uint64_t maxCycles = 50000000;
+  if (const char *value = std::getenv("CPPHDL_MAX_CYCLES"))
+    maxCycles = std::strtoull(value, nullptr, 0);
+  uint64_t progressCycles = 0;
+  if (const char *value = std::getenv("CPPHDL_PROGRESS_CYCLES"))
+    progressCycles = std::strtoull(value, nullptr, 0);
+
+  try {
+    for (uint64_t cycle = 0; cycle < maxCycles; ++cycle) {
+      reset = cycle < 10;
+      ++_system_clock;
+#ifdef CPPHDL_OPTIMIZE_COMBS
+      calc_all(top);
+      commit_optimized_regs(top);
+#else
+      top._work(false);
+      top._strobe();
+#endif
+      if (progressCycles && (cycle + 1) % progressCycles == 0)
+        std::fprintf(stderr, "[CPPHDL] cycle %llu\n",
+                     static_cast<unsigned long long>(cycle + 1));
+      uint32_t exit = firtool_cpphdl_runtime::exitCode();
+      if (exit) {
+        int code = exit >> 1;
+        std::fprintf(stderr, "\nC++HDL simulation finished after %llu cycles (code %d)\n",
+                     static_cast<unsigned long long>(cycle + 1), code);
+        return code;
+      }
+    }
+  } catch (const cpphdl_exception &error) {
+    std::fprintf(stderr, "C++HDL simulation error: %s\n", error.text.c_str());
+    return 2;
+  }
+  std::fprintf(stderr, "C++HDL simulation timed out after %llu cycles\n",
+               static_cast<unsigned long long>(maxCycles));
+  return 124;
+}
