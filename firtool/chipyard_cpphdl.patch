diff --git a/scripts/build-cpphdl-rocket64.sh b/scripts/build-cpphdl-rocket64.sh
new file mode 100755
index 0000000000000000000000000000000000000000..6600d112d7a2851985e2f81cd3f769153b10b8ac
--- /dev/null
+++ b/scripts/build-cpphdl-rocket64.sh
@@ -0,0 +1,143 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
+export RISCV=${RISCV:-"$root/.conda-env/riscv-tools"}
+export PATH="$RISCV/bin:$root/.conda-env/bin:$PATH"
+
+config=RocketConfig
+long_name="chipyard.harness.TestHarness.${config}"
+generated_root="$root/sims/verilator/generated-src/$long_name"
+fir_file="$generated_root/$long_name.fir"
+# Explicit backend takes precedence over the legacy comb switch.
+backend=${CPPHDL_BACKEND:-}
+if [[ -z "$backend" ]]; then
+  case ${CPPHDL_OPTIMIZE_COMBS:-0} in
+    0) backend=plain ;;
+    1) backend=optimize-combs ;;
+    *) echo 'error: CPPHDL_OPTIMIZE_COMBS must be 0 or 1' >&2; exit 1 ;;
+  esac
+fi
+case "$backend" in
+  plain) mode_dir=plain; target=cpphdl-rocket64-sim; default_opt=-O2 ;;
+  optimize-combs) mode_dir=optimize-combs; target=cpphdl-rocket64-optimized-sim; default_opt=-O2 ;;
+  native-graph) mode_dir=native-graph; target=cpphdl-rocket64-graph-sim; default_opt=-O2 ;;
+  *) echo "error: unknown CPPHDL_BACKEND: $backend" >&2; exit 1 ;;
+esac
+# Each backend owns its generated sources and build cache.
+mode_root="$root/cpphdl-build/$config/$mode_dir"
+# Preserve the existing comb build and its CMake cache in place.
+[[ "$backend" != optimize-combs ]] || mode_root="$root/cpphdl-build/$config"
+output_dir=${CPPHDL_OUTPUT_DIR:-"$mode_root/generated"}
+build_dir=${CPPHDL_BUILD_DIR:-"$mode_root/runtime"}
+program=${1:-"$root/tests/build/rocket64-mmul.riscv"}
+cpphdl_include=${CPPHDL_INCLUDE_DIR:-${HOME:?HOME must be set}/cpphdl/include}
+cpphdl_opt_level=${CPPHDL_OPT_LEVEL:-$default_opt}
+cpphdl_use_pch=${CPPHDL_USE_OPTIMIZED_PCH:-ON}
+cpphdl_optimize_threads=${CPPHDL_OPTIMIZE_THREADS:-}
+
+if [[ -n "$cpphdl_optimize_threads" &&
+      ! "$cpphdl_optimize_threads" =~ ^[1-9][0-9]*$ ]]; then
+  echo "error: CPPHDL_OPTIMIZE_THREADS must be a positive integer" >&2
+  exit 1
+fi
+
+if [[ ! -f "$fir_file" ]]; then
+  make -C "$root/sims/verilator" CONFIG="$config" firrtl
+fi
+if [[ ! -f "$program" ]]; then
+  cmake -S "$root/tests" -B "$root/tests/build" -DCMAKE_BUILD_TYPE=Release
+  cmake --build "$root/tests/build" --target rocket64-mmul \
+    --parallel "${CPPHDL_BUILD_JOBS:-2}"
+fi
+
+circt_source=${CIRCT_CPPHDL_SOURCE_DIR:-"$root/tools/circt-cpphdl"}
+firtool_build_dir=${CPPHDL_FIRTOOL_BUILD_DIR:-"$root/tools/firtool-cpphdl/build"}
+CPPHDL_FIRTOOL_BUILD_DIR="$firtool_build_dir" \
+  CIRCT_CPPHDL_SOURCE_DIR="$circt_source" \
+  JOBS="${CPPHDL_FIRTOOL_JOBS:-1}" \
+  "$root/scripts/build-firtool-cpphdl.sh"
+firtool="$firtool_build_dir/firtool-cpphdl"
+
+mkdir -p "$output_dir"
+if [[ "${CPPHDL_REGENERATE:-1}" == 1 || ! -f "$output_dir/CMakeLists.txt" ]]; then
+  "$firtool" --split-cpphdl -o="$output_dir" "$fir_file"
+fi
+
+if [[ "$backend" == optimize-combs ]]; then
+  cpphdl_tool=${CPPHDL_TOOL:-${HOME:?HOME must be set}/cpphdl/build/cpphdl}
+  if [[ ! -x "$cpphdl_tool" ]]; then
+    echo "error: cpphdl comb optimizer is not executable: $cpphdl_tool" >&2
+    exit 1
+  fi
+  if [[ "${CPPHDL_REOPTIMIZE_COMBS:-1}" == 1 || \
+        ! -f "$output_dir/TestHarness_optimized_combs.cpp" ]]; then
+    mapfile -d '' cpphdl_model_sources < <(
+      find "$output_dir" -maxdepth 1 -type f -name '*.cpp' \
+        ! -name '*_optimized_combs*.cpp' -print0 | sort -z)
+    cpphdl_optimizer_args=(--optimize-combs TestHarness)
+    if [[ -n "$cpphdl_optimize_threads" ]]; then
+      cpphdl_optimizer_args+=(--optimize-threads "$cpphdl_optimize_threads")
+    fi
+    "$cpphdl_tool" "${cpphdl_optimizer_args[@]}" \
+      --generated-dir="$output_dir" "${cpphdl_model_sources[@]}" -- \
+      -I"$output_dir" -I"$cpphdl_include" \
+      -I"$root/tools/firtool-cpphdl/runtime"
+    mapfile -d '' optimized_outputs < <(
+      find "$output_dir" -maxdepth 1 -type f \
+        -name 'TestHarness_optimized_combs*' -print0)
+    if [[ ${#optimized_outputs[@]} -eq 0 ]]; then
+      echo "error: cpphdl comb optimizer produced no output files" >&2
+      exit 1
+    fi
+    for optimized_output in "${optimized_outputs[@]}"; do
+      if [[ ! -s "$optimized_output" ]]; then
+        echo "error: empty cpphdl comb optimizer output: $optimized_output" >&2
+        exit 1
+      fi
+      case $(basename "$optimized_output") in
+        TestHarness_optimized_combs_[0-9]*.cpp)
+          if grep -qF '_clock = _system_clock;' "$optimized_output"; then
+            echo "error: optimized comb chunk writes memoization clocks: $optimized_output" >&2
+            exit 1
+          fi
+          ;;
+      esac
+    done
+  fi
+fi
+
+if [[ "$backend" == optimize-combs ]]; then
+optimized_api="$output_dir/TestHarness_optimized_combs.cpp"
+if [[ ! -s "$optimized_api" ]] || \
+   ! grep -qF 'void bind_optimized_ports(TestHarness& obj)' "$optimized_api" || \
+   ! grep -Eq 'void calc_all\(TestHarness& obj(, bool reset)?\)' "$optimized_api" || \
+   ! grep -qF 'void commit_optimized_regs(TestHarness& obj)' "$optimized_api"; then
+  echo "error: complete optimized TestHarness API was not generated" >&2
+  exit 1
+fi
+if grep -Eq -- '->_(work|assign)\(|\._(work|assign)\(' \
+    "$output_dir"/TestHarness_optimized_combs*.cpp; then
+  echo "error: optimized TestHarness sources call _work or _assign" >&2
+  exit 1
+fi
+
+fi
+
+if [[ "$backend" == native-graph ]]; then
+  exec "$root/scripts/build-cpphdl-rocket64-graph.sh" "$output_dir" "$build_dir"
+fi
+
+cmake -S "$root/tools/firtool-cpphdl/runtime" -B "$build_dir" \
+  -DCPPHDL_BACKEND="$backend" \
+  -DCPPHDL_GENERATED_DIR="$output_dir" \
+  -DCHIPYARD_DIR="$root" \
+  -DCPPHDL_INCLUDE_DIR="$cpphdl_include" \
+  -DCPPHDL_OPT_LEVEL="$cpphdl_opt_level" \
+  -DCPPHDL_USE_OPTIMIZED_PCH="$cpphdl_use_pch"
+cmake --build "$build_dir" --target "$target" \
+  --parallel "${CPPHDL_BUILD_JOBS:-2}"
+
+echo "C++HDL backend: $backend (compiler $cpphdl_opt_level)"
+echo "Simulator: $build_dir/$target"
+echo "RV64 matrix ELF: $program"
diff --git a/scripts/build-firtool-cpphdl.sh b/scripts/build-firtool-cpphdl.sh
new file mode 100755
index 0000000000000000000000000000000000000000..46df2473d1b40f2364094273da0e1d87127ee700
--- /dev/null
+++ b/scripts/build-firtool-cpphdl.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
+prefix=${CPPHDL_CIRCT_PREFIX:-"$root/tools/circt-cpphdl-sdk"}
+build_dir=${CPPHDL_FIRTOOL_BUILD_DIR:-"$root/tools/firtool-cpphdl/build"}
+source_dir=${CIRCT_CPPHDL_SOURCE_DIR:-"$root/tools/circt"}
+
+cmake -S "$root/tools/firtool-cpphdl" -B "$build_dir" \
+  -DCMAKE_BUILD_TYPE=Release \
+  -DCIRCT_CPPHDL_SOURCE_DIR="$source_dir" \
+  -DLLVM_DIR="$prefix/lib/cmake/llvm" \
+  -DMLIR_DIR="$prefix/lib/cmake/mlir" \
+  -DCIRCT_DIR="$prefix/lib/cmake/circt"
+cmake --build "$build_dir" --target firtool-cpphdl --parallel "${JOBS:-2}"
+
+echo "$build_dir/firtool-cpphdl"
