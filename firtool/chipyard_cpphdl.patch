diff --git a/tests/rocket64_mmul.c b/tests/rocket64_mmul.c
new file mode 100644
index 0000000000000000000000000000000000000000..08fe5b8e6d2318f053550a469ed410a2a2e74075
--- /dev/null
+++ b/tests/rocket64_mmul.c
@@ -0,0 +1,148 @@
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+
+static volatile uint64_t memory_words[4] __attribute__((aligned(64)));
+
+enum { MATRIX_SIZE = 16, MATRIX_ROUNDS = 8 };
+static volatile uint64_t matrix_a[MATRIX_SIZE][MATRIX_SIZE];
+static volatile uint64_t matrix_b[MATRIX_SIZE][MATRIX_SIZE];
+static volatile uint64_t matrix_c[MATRIX_SIZE][MATRIX_SIZE];
+
+static uint64_t rv64_add(uint64_t lhs, uint64_t rhs) {
+  uint64_t result;
+  __asm__ volatile("add %0, %1, %2" : "=r"(result) : "r"(lhs), "r"(rhs));
+  return result;
+}
+
+static uint64_t rv64_mul(uint64_t lhs, uint64_t rhs) {
+  uint64_t result;
+  __asm__ volatile("mul %0, %1, %2" : "=r"(result) : "r"(lhs), "r"(rhs));
+  return result;
+}
+
+static uint64_t rv64_divu(uint64_t lhs, uint64_t rhs) {
+  uint64_t result;
+  __asm__ volatile("divu %0, %1, %2" : "=r"(result) : "r"(lhs), "r"(rhs));
+  return result;
+}
+
+static uint64_t rv64_sll(uint64_t value, uint64_t amount) {
+  uint64_t result;
+  __asm__ volatile("sll %0, %1, %2" : "=r"(result) : "r"(value), "r"(amount));
+  return result;
+}
+
+static int64_t rv64_addiw(int64_t value) {
+  int64_t result;
+  __asm__ volatile("addiw %0, %1, 1" : "=r"(result) : "r"(value));
+  return result;
+}
+
+static uint64_t rv64_load_store(uint64_t value) {
+  uint64_t result;
+  volatile uint64_t *address = &memory_words[0];
+  __asm__ volatile(
+      "sd %1, 0(%2)\n\t"
+      "ld %0, 0(%2)"
+      : "=r"(result), "+r"(value)
+      : "r"(address)
+      : "memory");
+  return result;
+}
+
+static int check(const char *operation, uint64_t actual, uint64_t expected) {
+  if (actual == expected)
+    return 0;
+  printf("ROCKET RV64 MMUL TEST FAILED: %s actual=0x%016" PRIx64
+         " expected=0x%016" PRIx64 "\n",
+         operation, actual, expected);
+  return 1;
+}
+
+static int run_matrix_multiply(uint64_t *aggregate_result) {
+  for (unsigned i = 0; i < MATRIX_SIZE; ++i) {
+    for (unsigned j = 0; j < MATRIX_SIZE; ++j) {
+      matrix_a[i][j] = (i * 17U + j * 13U + 1U) & 0xffU;
+      matrix_b[i][j] = (i * 7U + j * 19U + 3U) & 0x7fU;
+      matrix_c[i][j] = 0;
+    }
+  }
+
+  printf("RV64 matrix workload: %ux%u, %u rounds\n",
+         MATRIX_SIZE, MATRIX_SIZE, MATRIX_ROUNDS);
+
+  uint64_t aggregate = 0;
+  for (unsigned round = 0; round < MATRIX_ROUNDS; ++round) {
+    for (unsigned i = 0; i < MATRIX_SIZE; ++i) {
+      for (unsigned j = 0; j < MATRIX_SIZE; ++j) {
+        uint64_t sum = 0;
+        for (unsigned k = 0; k < MATRIX_SIZE; ++k)
+          sum += matrix_a[i][k] * matrix_b[k][j];
+        matrix_c[i][j] = sum;
+      }
+    }
+
+    uint64_t checksum = UINT64_C(1469598103934665603);
+    for (unsigned i = 0; i < MATRIX_SIZE; ++i) {
+      for (unsigned j = 0; j < MATRIX_SIZE; ++j) {
+        checksum ^= matrix_c[i][j];
+        checksum *= UINT64_C(1099511628211);
+      }
+    }
+    aggregate ^= checksum + round * UINT64_C(0x9e3779b97f4a7c15);
+
+    if ((round & 1U) == 1U)
+      printf("RV64 matrix progress: %u/%u rounds\n", round + 1U,
+             MATRIX_ROUNDS);
+  }
+
+  if (check("matrix C[0][0]", matrix_c[0][0], UINT64_C(118408)) ||
+      check("matrix C[15][15]", matrix_c[15][15], UINT64_C(114504)) ||
+      check("matrix aggregate", aggregate, UINT64_C(0x7c4069f402f40058)))
+    return 1;
+
+  *aggregate_result = aggregate;
+  return 0;
+}
+
+int main(void) {
+  const uint64_t a = UINT64_C(0xfedcba9876543210);
+  const uint64_t b = UINT64_C(0x0123456789abcdef);
+  uint64_t signature = UINT64_C(0x525636344e415449);
+
+  if (sizeof(uintptr_t) != 8) {
+    printf("ROCKET RV64 MMUL TEST FAILED: sizeof(uintptr_t)=%u\n",
+           (unsigned)sizeof(uintptr_t));
+    return 1;
+  }
+
+  const uint64_t sum = rv64_add(a, b);
+  const uint64_t product = rv64_mul(UINT64_C(0x123456789), UINT64_C(0x10203));
+  const uint64_t quotient = rv64_divu(UINT64_C(0xfedcba9876543210), UINT64_C(0x12345));
+  const uint64_t shifted = rv64_sll(UINT64_C(0x12345678), 40);
+  const uint64_t loaded = rv64_load_store(a);
+  const uint64_t word_sign_extended = (uint64_t)rv64_addiw(INT64_C(0x7fffffff));
+  uint64_t matrix_aggregate = 0;
+
+  if (check("add", sum, UINT64_C(0xffffffffffffffff)) ||
+      check("mul", product, UINT64_C(0x1258f5c28489b)) ||
+      check("divu", quotient, UINT64_C(0xe0004fa01c4d)) ||
+      check("sll", shifted, UINT64_C(0x3456780000000000)) ||
+      check("sd/ld", loaded, a) ||
+      check("addiw", word_sign_extended, UINT64_C(0xffffffff80000000)) ||
+      run_matrix_multiply(&matrix_aggregate))
+    return 1;
+
+  signature ^= sum;
+  signature ^= product;
+  signature ^= quotient;
+  signature ^= shifted;
+  signature ^= loaded;
+  signature ^= word_sign_extended;
+  signature ^= matrix_aggregate;
+
+  printf("ROCKET RV64 MMUL TEST PASSED: signature=0x%016" PRIx64 "\n",
+         signature);
+  return 0;
+}
diff --git a/tools/firtool-cpphdl/CMakeLists.txt b/tools/firtool-cpphdl/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..5cf080684ecce689e4fd3bb5cd7c735905621da2
--- /dev/null
+++ b/tools/firtool-cpphdl/CMakeLists.txt
@@ -0,0 +1,52 @@
+cmake_minimum_required(VERSION 3.20)
+project(firtool_cpphdl LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CIRCT_CPPHDL_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../circt" CACHE PATH
+    "CIRCT source tree containing the C++HDL exporter patch")
+
+find_package(LLVM REQUIRED CONFIG)
+find_package(MLIR REQUIRED CONFIG)
+find_package(CIRCT REQUIRED CONFIG)
+
+add_executable(firtool-cpphdl
+  ${CIRCT_CPPHDL_SOURCE_DIR}/tools/firtool/firtool.cpp
+  ${CIRCT_CPPHDL_SOURCE_DIR}/lib/Conversion/ExportCppHDL/ExportCppHDL.cpp
+)
+
+# Installed headers come first because they contain TableGen output. The
+# modified CIRCT source tree then contributes the new ExportCppHDL interface.
+target_include_directories(firtool-cpphdl PRIVATE
+  ${CIRCT_INCLUDE_DIRS}
+  ${MLIR_INCLUDE_DIRS}
+  ${LLVM_INCLUDE_DIRS}
+  ${CIRCT_CPPHDL_SOURCE_DIR}/include
+)
+target_compile_definitions(firtool-cpphdl PRIVATE ${LLVM_DEFINITIONS})
+
+target_link_libraries(firtool-cpphdl PRIVATE
+  CIRCTExportVerilog
+  CIRCTImportFIRFile
+  CIRCTFIRRTLTransforms
+  CIRCTHWTransforms
+  CIRCTOMTransforms
+  CIRCTSeq
+  CIRCTSim
+  CIRCTSVTransforms
+  CIRCTTransforms
+  CIRCTFirtool
+  CIRCTTargetDebugInfo
+  MLIRBytecodeReader
+  MLIRBytecodeWriter
+  MLIRParser
+  MLIRSupport
+  MLIRIR
+  MLIROptLib
+  MLIRFuncDialect
+  MLIRTransforms
+)
+
+if(NOT LLVM_ENABLE_RTTI)
+  target_compile_options(firtool-cpphdl PRIVATE -fno-rtti)
+endif()
diff --git a/tools/firtool-cpphdl/runtime/CMakeLists.txt b/tools/firtool-cpphdl/runtime/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..9d464c9ce2f5d89a4a5f30a9d224155d5c85aff7
--- /dev/null
+++ b/tools/firtool-cpphdl/runtime/CMakeLists.txt
@@ -0,0 +1,79 @@
+cmake_minimum_required(VERSION 3.20)
+project(chipyard_cpphdl_runtime LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CPPHDL_GENERATED_DIR "" CACHE PATH "Generated C++HDL source directory")
+set(CHIPYARD_DIR "" CACHE PATH "Chipyard source directory")
+set(CPPHDL_INCLUDE_DIR "$ENV{HOME}/cpphdl/include" CACHE PATH
+    "C++HDL include directory")
+set(CPPHDL_BACKEND "plain" CACHE STRING "plain or optimize-combs")
+if(CPPHDL_BACKEND STREQUAL "plain")
+  set(SIM_TARGET cpphdl-rocket64-sim)
+  set(DEFAULT_OPT_LEVEL "-O2")
+elseif(CPPHDL_BACKEND STREQUAL "optimize-combs")
+  set(SIM_TARGET cpphdl-rocket64-optimized-sim)
+  set(DEFAULT_OPT_LEVEL "-O2")
+else()
+  message(FATAL_ERROR "Unsupported runtime backend: ${CPPHDL_BACKEND}")
+endif()
+set(CPPHDL_OPT_LEVEL "${DEFAULT_OPT_LEVEL}" CACHE STRING "C++HDL simulator optimization flag")
+option(CPPHDL_USE_OPTIMIZED_PCH
+  "Precompile the shared optimized C++HDL model declarations" ON)
+
+if(NOT CPPHDL_GENERATED_DIR OR NOT EXISTS "${CPPHDL_GENERATED_DIR}/TestHarness.h")
+  message(FATAL_ERROR "CPPHDL_GENERATED_DIR must name firtool --split-cpphdl output")
+endif()
+if(CPPHDL_BACKEND STREQUAL "optimize-combs" AND
+   (NOT EXISTS "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs.cpp" OR
+    NOT EXISTS "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs.h"))
+  message(FATAL_ERROR "Rocket runtime requires cpphdl --optimize-combs output")
+endif()
+if(NOT CHIPYARD_DIR)
+  message(FATAL_ERROR "CHIPYARD_DIR is required")
+endif()
+
+set(COLLATERAL
+    "${CHIPYARD_DIR}/generators/testchipip/src/main/resources/testchipip/csrc")
+add_executable(${SIM_TARGET}
+  sim_main.cpp
+  cpphdl_runtime.cpp
+  cpphdl_external_models.cpp
+  "${COLLATERAL}/mm.cc"
+  "${COLLATERAL}/testchip_tsi.cc"
+  "${COLLATERAL}/testchip_htif.cc")
+if(CPPHDL_BACKEND STREQUAL "optimize-combs")
+  set_source_files_properties(sim_main.cpp PROPERTIES COMPILE_DEFINITIONS CPPHDL_OPTIMIZE_COMBS=1)
+  file(GLOB CPPHDL_OPTIMIZED_SOURCES CONFIGURE_DEPENDS
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs.cpp"
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_[0-9]*.cpp"
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_prefix_[0-9]*.cpp"
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_thread_[0-9]*_[0-9]*_[0-9]*.cpp"
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_bind_[0-9]*.cpp"
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_work_[0-9]*.cpp"
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_strobe_[0-9]*.cpp"
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_model_[0-9]*.cpp"
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_memory_[0-9]*.cpp"
+    "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_dynamic_[0-9]*.cpp")
+  target_sources(${SIM_TARGET} PRIVATE ${CPPHDL_OPTIMIZED_SOURCES})
+  if(CPPHDL_USE_OPTIMIZED_PCH)
+    target_precompile_headers(${SIM_TARGET} PRIVATE
+      "${CPPHDL_GENERATED_DIR}/TestHarness_optimized_combs_internal.h")
+  endif()
+else()
+  add_subdirectory("${CPPHDL_GENERATED_DIR}" generated-model)
+  target_sources(${SIM_TARGET} PRIVATE $<TARGET_OBJECTS:firtool_generated_cpphdl>)
+  target_include_directories(firtool_generated_cpphdl PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
+endif()
+target_compile_options(${SIM_TARGET} PRIVATE ${CPPHDL_OPT_LEVEL})
+target_include_directories(${SIM_TARGET} PRIVATE
+  "${CMAKE_CURRENT_SOURCE_DIR}"
+  "${CPPHDL_GENERATED_DIR}"
+  "${CPPHDL_INCLUDE_DIR}"
+  "${COLLATERAL}"
+  "${CHIPYARD_DIR}/.conda-env/riscv-tools/include")
+target_link_directories(${SIM_TARGET} PRIVATE
+  "${CHIPYARD_DIR}/.conda-env/riscv-tools/lib")
+target_link_libraries(${SIM_TARGET} PRIVATE
+  fesvr riscv dl pthread)
+target_link_options(${SIM_TARGET} PRIVATE
+  "-Wl,-rpath,${CHIPYARD_DIR}/.conda-env/riscv-tools/lib")
diff --git a/tools/firtool-cpphdl/runtime/cpphdl_external_models.cpp b/tools/firtool-cpphdl/runtime/cpphdl_external_models.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fee64adacf20b671b7c2b534f04efa7f06ddc048
--- /dev/null
+++ b/tools/firtool-cpphdl/runtime/cpphdl_external_models.cpp
@@ -0,0 +1,98 @@
+#include "cpphdl_external_models.h"
+
+#include "ClockSourceAtFreqMHz.h"
+#include "ClockSourceAtFreqMHz_1.h"
+#include "EICG_wrapper.h"
+#include "GenericDigitalInIOCell.h"
+#include "GenericDigitalOutIOCell.h"
+#include "SimDRAM.h"
+#include "SimTSI.h"
+#include "SimUART.h"
+#include "cpphdl_runtime.h"
+
+#include <cstdio>
+
+namespace firtool_cpphdl_external {
+
+void work(ClockSourceAtFreqMHz &module, bool) {
+  module.cpphdl_drive_clk(module.power() && !module.gate());
+}
+
+void work(ClockSourceAtFreqMHz_1 &module, bool) {
+  module.cpphdl_drive_clk(module.power() && !module.gate());
+}
+
+void work(EICG_wrapper &module, bool) {
+  module.cpphdl_drive_out(module.in() && (module.en() || module.test_en()));
+}
+
+void work(GenericDigitalInIOCell &module, bool) {
+  module.cpphdl_drive_i(module.ie() ? module.pad() : cpphdl::logic<1>(0));
+}
+
+void work(GenericDigitalOutIOCell &module, bool) {
+  module.cpphdl_drive_pad(module.oe() ? module.o() : cpphdl::logic<1>(0));
+}
+
+void work(SimUART &module, bool) {
+  module.cpphdl_drive_serial_in_valid(0);
+  module.cpphdl_drive_serial_in_bits(0);
+  module.cpphdl_drive_serial_out_ready(!module.reset());
+  if (!module.reset() && module.serial_out_valid()) {
+    std::putchar(
+        static_cast<unsigned>(static_cast<uint64_t>(module.serial_out_bits())));
+    std::fflush(stdout);
+  }
+}
+
+void work(SimTSI &module, bool) {
+  auto &model =
+      module.cpphdl_external_state<firtool_cpphdl_runtime::TSIModel>();
+  firtool_cpphdl_runtime::TSIOutputs out;
+  model.tick(module.reset(), module.tsi_out_valid(),
+             static_cast<uint64_t>(module.tsi_out_bits()),
+             module.tsi_in_ready(), out);
+  module.cpphdl_drive_tsi_in_valid(out.inValid);
+  module.cpphdl_drive_tsi_in_bits(out.inBits);
+  module.cpphdl_drive_tsi_out_ready(out.outReady);
+  module.cpphdl_drive_exit(out.exit);
+}
+
+void work(SimDRAM &module, bool) {
+  auto &model =
+      module.cpphdl_external_state<firtool_cpphdl_runtime::DRAMModel>();
+  firtool_cpphdl_runtime::DRAMInputs in;
+  in.reset = module.reset();
+  in.arValid = module.axi_ar_valid();
+  in.arAddr = static_cast<uint64_t>(module.axi_ar_bits_addr());
+  in.arId = static_cast<uint64_t>(module.axi_ar_bits_id());
+  in.arSize = static_cast<uint64_t>(module.axi_ar_bits_size());
+  in.arLen = static_cast<uint64_t>(module.axi_ar_bits_len());
+  in.awValid = module.axi_aw_valid();
+  in.awAddr = static_cast<uint64_t>(module.axi_aw_bits_addr());
+  in.awId = static_cast<uint64_t>(module.axi_aw_bits_id());
+  in.awSize = static_cast<uint64_t>(module.axi_aw_bits_size());
+  in.awLen = static_cast<uint64_t>(module.axi_aw_bits_len());
+  in.wValid = module.axi_w_valid();
+  in.wStrb = static_cast<uint64_t>(module.axi_w_bits_strb());
+  in.wData = static_cast<uint64_t>(module.axi_w_bits_data());
+  in.wLast = module.axi_w_bits_last();
+  in.rReady = module.axi_r_ready();
+  in.bReady = module.axi_b_ready();
+
+  firtool_cpphdl_runtime::DRAMOutputs out;
+  model.tick(in, out);
+  module.cpphdl_drive_axi_ar_ready(out.arReady);
+  module.cpphdl_drive_axi_aw_ready(out.awReady);
+  module.cpphdl_drive_axi_w_ready(out.wReady);
+  module.cpphdl_drive_axi_b_valid(out.bValid);
+  module.cpphdl_drive_axi_b_bits_id(out.bId);
+  module.cpphdl_drive_axi_b_bits_resp(out.bResp);
+  module.cpphdl_drive_axi_r_valid(out.rValid);
+  module.cpphdl_drive_axi_r_bits_id(out.rId);
+  module.cpphdl_drive_axi_r_bits_data(out.rData);
+  module.cpphdl_drive_axi_r_bits_resp(out.rResp);
+  module.cpphdl_drive_axi_r_bits_last(out.rLast);
+}
+
+} // namespace firtool_cpphdl_external
