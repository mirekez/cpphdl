diff --git a/tools/firtool-cpphdl/runtime/cpphdl_runtime.cpp b/tools/firtool-cpphdl/runtime/cpphdl_runtime.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8aa42068d069222a94584ecdf7c24f495506e1b4
--- /dev/null
+++ b/tools/firtool-cpphdl/runtime/cpphdl_runtime.cpp
@@ -0,0 +1,172 @@
+#include "cpphdl_runtime.h"
+
+#include <cpphdl.h>
+#include "mm.h"
+#include "testchip_tsi.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <sys/mman.h>
+#include <vector>
+
+namespace firtool_cpphdl_runtime {
+namespace {
+int runtimeArgc = 0;
+char **runtimeArgv = nullptr;
+uint32_t runtimeExit = 0;
+uint8_t *dramData = nullptr;
+constexpr uint64_t dramBase = 0x80000000ULL;
+constexpr size_t dramSize = 256ULL * 1024 * 1024;
+}
+
+void configure(int argc, char **argv) {
+  runtimeArgc = argc;
+  runtimeArgv = argv;
+}
+
+uint32_t exitCode() { return runtimeExit; }
+
+struct TSIModel::Impl {
+  testchip_tsi_t *tsi = nullptr;
+  uint64_t cycles = 0;
+  uint64_t wordsToTarget = 0;
+  uint64_t wordsFromTarget = 0;
+};
+
+class DirectMemoryTSI : public testchip_tsi_t {
+public:
+  DirectMemoryTSI(int argc, char **argv) : testchip_tsi_t(argc, argv, true) {}
+
+protected:
+  void load_mem_write(addr_t address, size_t size, const void *source) override {
+    if (!dramData || address < dramBase || address + size > dramBase + dramSize)
+      throw cpphdl_exception{"FESVR loadmem write is outside C++HDL DRAM"};
+    std::memcpy(dramData + address - dramBase, source, size);
+  }
+  void load_mem_read(addr_t address, size_t size, void *destination) override {
+    if (!dramData || address < dramBase || address + size > dramBase + dramSize)
+      throw cpphdl_exception{"FESVR loadmem read is outside C++HDL DRAM"};
+    std::memcpy(destination, dramData + address - dramBase, size);
+  }
+};
+
+TSIModel::TSIModel() : impl(new Impl) {}
+TSIModel::~TSIModel() { delete impl->tsi; delete impl; }
+
+void TSIModel::tick(bool reset, bool outValid, uint32_t outBits, bool inReady,
+                    TSIOutputs &outputs) {
+  if (reset) {
+    outputs = {};
+    return;
+  }
+  if (!impl->tsi) {
+    if (!runtimeArgv)
+      throw cpphdl_exception{"C++HDL runtime was not configured"};
+    impl->tsi = new DirectMemoryTSI(runtimeArgc, runtimeArgv);
+  }
+  impl->tsi->tick(outValid, outBits, inReady);
+  impl->tsi->switch_to_host();
+  outputs.inValid = impl->tsi->in_valid();
+  outputs.inBits = impl->tsi->in_bits();
+  outputs.outReady = impl->tsi->out_ready();
+  outputs.exit = impl->tsi->done() ? (impl->tsi->exit_code() << 1 | 1) : 0;
+  runtimeExit = outputs.exit;
+  ++impl->cycles;
+  if (outputs.inValid && inReady) {
+    ++impl->wordsToTarget;
+    if (std::getenv("CPPHDL_TSI_TRACE") && impl->wordsToTarget <= 64)
+      std::fprintf(stderr, "[CPPHDL TSI] -> %08x at %llu\n", outputs.inBits,
+                   static_cast<unsigned long long>(impl->cycles));
+  }
+  if (outValid && outputs.outReady) {
+    ++impl->wordsFromTarget;
+    if (std::getenv("CPPHDL_TSI_TRACE") && impl->wordsFromTarget <= 64)
+      std::fprintf(stderr, "[CPPHDL TSI] <- %08x at %llu\n", outBits,
+                   static_cast<unsigned long long>(impl->cycles));
+  }
+  if (std::getenv("CPPHDL_TSI_TRACE") && impl->cycles % 10000 == 0)
+    std::fprintf(stderr,
+                 "[CPPHDL TSI] cycles=%llu to_target=%llu from_target=%llu in_valid=%d in_ready=%d out_valid=%d out_ready=%d\n",
+                 static_cast<unsigned long long>(impl->cycles),
+                 static_cast<unsigned long long>(impl->wordsToTarget),
+                 static_cast<unsigned long long>(impl->wordsFromTarget),
+                 outputs.inValid, inReady, outValid, outputs.outReady);
+}
+
+struct DRAMModel::Impl {
+  uint8_t *data = nullptr;
+  mm_magic_t *memory = nullptr;
+  uint64_t cycles = 0, reads = 0, writes = 0, writeData = 0;
+
+  Impl() {
+    data = static_cast<uint8_t *>(mmap(nullptr, dramSize, PROT_READ | PROT_WRITE,
+                                      MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+    if (data == MAP_FAILED)
+      throw cpphdl_exception{"cannot allocate C++HDL DRAM backing memory"};
+    dramData = data;
+    backing_data_t backing{data, dramSize};
+    memory = new mm_magic_t(dramBase, dramSize, 8, 64, backing);
+  }
+  ~Impl() {
+    delete memory;
+    if (dramData == data)
+      dramData = nullptr;
+    munmap(data, dramSize);
+  }
+};
+
+DRAMModel::DRAMModel() : impl(new Impl) {}
+DRAMModel::~DRAMModel() { delete impl; }
+
+void DRAMModel::tick(const DRAMInputs &in, DRAMOutputs &out) {
+  uint64_t writeData = in.wData;
+  impl->memory->tick(in.reset, in.arValid, in.arAddr, in.arId, in.arSize,
+                     in.arLen, in.awValid, in.awAddr, in.awId, in.awSize,
+                     in.awLen, in.wValid, in.wStrb, &writeData, in.wLast,
+                     in.rReady, in.bReady);
+  out.arReady = impl->memory->ar_ready();
+  out.awReady = impl->memory->aw_ready();
+  out.wReady = impl->memory->w_ready();
+  out.bValid = impl->memory->b_valid();
+  out.bResp = impl->memory->b_resp();
+  out.bId = impl->memory->b_id();
+  out.rValid = impl->memory->r_valid();
+  out.rResp = impl->memory->r_resp();
+  out.rId = impl->memory->r_id();
+  std::memcpy(&out.rData, impl->memory->r_data(), sizeof(out.rData));
+  out.rLast = impl->memory->r_last();
+  ++impl->cycles;
+  if (in.arValid && out.arReady) ++impl->reads;
+  if (in.awValid && out.awReady) ++impl->writes;
+  if (in.wValid && out.wReady) ++impl->writeData;
+  if (std::getenv("CPPHDL_DRAM_TRACE") && in.arValid && out.arReady &&
+      impl->reads <= 64)
+    std::fprintf(stderr,
+                 "[CPPHDL DRAM] AR count=%llu addr=%016llx id=%llu size=%u len=%u\n",
+                 static_cast<unsigned long long>(impl->reads),
+                 static_cast<unsigned long long>(in.arAddr),
+                 static_cast<unsigned long long>(in.arId),
+                 static_cast<unsigned>(in.arSize),
+                 static_cast<unsigned>(in.arLen));
+  if (std::getenv("CPPHDL_DRAM_TRACE") && out.rValid && in.rReady &&
+      impl->reads <= 64)
+    std::fprintf(stderr,
+                 "[CPPHDL DRAM] R addr_count=%llu id=%llu resp=%u last=%u data=%016llx\n",
+                 static_cast<unsigned long long>(impl->reads),
+                 static_cast<unsigned long long>(out.rId),
+                 static_cast<unsigned>(out.rResp),
+                 static_cast<unsigned>(out.rLast),
+                 static_cast<unsigned long long>(out.rData));
+  if (std::getenv("CPPHDL_DRAM_TRACE") && impl->cycles % 10000 == 0)
+    std::fprintf(stderr,
+                 "[CPPHDL DRAM] cycles=%llu ar=%llu aw=%llu w=%llu ar_valid=%d ar_ready=%d\n",
+                 static_cast<unsigned long long>(impl->cycles),
+                 static_cast<unsigned long long>(impl->reads),
+                 static_cast<unsigned long long>(impl->writes),
+                 static_cast<unsigned long long>(impl->writeData), in.arValid,
+                 out.arReady);
+}
+
+} // namespace firtool_cpphdl_runtime
