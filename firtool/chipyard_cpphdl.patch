diff --git a/scripts/build-cpphdl-rocket64-graph.sh b/scripts/build-cpphdl-rocket64-graph.sh
new file mode 100755
index 0000000000000000000000000000000000000000..c469c7bda8b23cd10b605d75b65f665e10095700
--- /dev/null
+++ b/scripts/build-cpphdl-rocket64-graph.sh
@@ -0,0 +1,72 @@
+#!/usr/bin/env bash
+# Lower C++ modules separately, link their graphs, then build the host runner.
+set -euo pipefail
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
+output_dir=${1:?generated model directory required}
+build_dir=${2:?graph build directory required}
+cpphdl_tool=${CPPHDL_TOOL:-"$HOME/cpphdl/build/cpphdl"}
+cpphdl_include=${CPPHDL_INCLUDE_DIR:-"$HOME/cpphdl/include"}
+cpphdl_root=$(cd "$cpphdl_include/.." && pwd -P)
+partition_tool=${CPPHDL_GRAPH_PARTITION_TOOL:-"$cpphdl_root/firtool/graph_partitions.py"}
+link_source=${CPPHDL_GRAPH_LINK_SOURCE:-"$cpphdl_root/tools/cpphdl-graph-link.cpp"}
+cxx=${CPPHDL_GRAPH_CXX:-clang++}
+[[ -x "$cpphdl_tool" && -f "$partition_tool" && -f "$link_source" ]] || {
+  echo "error: current cpphdl compiler and graph partition tools are required" >&2; exit 1;
+}
+ulimit -c 0
+if [[ -n "${CPPHDL_GRAPH_MAX_VMEM_KB:-}" ]]; then
+  [[ "$CPPHDL_GRAPH_MAX_VMEM_KB" =~ ^[1-9][0-9]*$ ]] || {
+    echo "error: CPPHDL_GRAPH_MAX_VMEM_KB must be a positive integer" >&2; exit 1;
+  }
+  ulimit -v "$CPPHDL_GRAPH_MAX_VMEM_KB"
+fi
+mkdir -p "$build_dir"
+attempt=$(mktemp -d "$build_dir/attempt.XXXXXX")
+trap 'status=$?; if (( status )); then echo "error: graph build failed; diagnostics: $attempt" >&2; fi' EXIT
+partitions="$build_dir/partitions"
+echo "Native graph partitions and host runner; diagnostics: $attempt"
+python3 "$partition_tool" --source "$output_dir" --output "$partitions" \
+  --cpphdl "$cpphdl_tool" --include "$cpphdl_include" \
+  --jobs "${CPPHDL_GRAPH_JOBS:-1}" 2>&1 | tee "$attempt/extract.log"
+linker="$build_dir/graph-link"
+if [[ ! -x "$linker" || "$link_source" -nt "$linker" || \
+      "$cpphdl_include/cpphdl_graph.h" -nt "$linker" || \
+      "$cpphdl_include/cpphdl_graph_native.h" -nt "$linker" ]]; then
+  "$cxx" -std=c++23 -O2 -I"$cpphdl_include" "$link_source" -o "$linker" \
+    > "$attempt/build-linker.log" 2>&1
+fi
+"$linker" "$partitions/link.plan" "$attempt/model.h" 2>&1 | tee "$attempt/link.log"
+cp "$partitions/runner.cpp" "$partitions/hosts.json" "$attempt/"
+python3 - "$attempt" "$root" "$output_dir" "$cpphdl_include" <<'PY'
+import json
+from pathlib import Path
+import sys
+attempt, root, generated, include = map(Path, sys.argv[1:])
+hosts = json.loads((attempt / 'hosts.json').read_text())
+runtime = root / 'tools/firtool-cpphdl/runtime'
+collateral = root / 'generators/testchipip/src/main/resources/testchipip/csrc'
+riscv = root / '.conda-env/riscv-tools'
+sources = [attempt / 'runner.cpp', runtime / 'cpphdl_runtime.cpp',
+           runtime / 'cpphdl_external_models.cpp', collateral / 'mm.cc',
+           collateral / 'testchip_tsi.cc', collateral / 'testchip_htif.cc']
+sources += [generated / (name + '.cpp') for name in sorted({h['type'] for h in hosts})]
+quote = lambda paths: '\n'.join(json.dumps(str(p)) for p in paths)
+(attempt / 'CMakeLists.txt').write_text(
+    'cmake_minimum_required(VERSION 3.16)\nproject(RocketNativeGraph LANGUAGES CXX)\n'
+    'set(CMAKE_CXX_STANDARD 23)\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\n'
+    'add_executable(cpphdl-rocket64-graph-sim\n' + quote(sources) + ')\n'
+    'target_compile_options(cpphdl-rocket64-graph-sim PRIVATE -O2)\n'
+    'target_include_directories(cpphdl-rocket64-graph-sim PRIVATE\n' +
+    quote([attempt, runtime, generated, include, collateral, riscv / 'include']) + ')\n'
+    'target_link_directories(cpphdl-rocket64-graph-sim PRIVATE ' + json.dumps(str(riscv / 'lib')) + ')\n'
+    'target_link_libraries(cpphdl-rocket64-graph-sim PRIVATE fesvr riscv dl pthread)\n'
+    'target_link_options(cpphdl-rocket64-graph-sim PRIVATE ' + json.dumps('-Wl,-rpath,' + str(riscv / 'lib')) + ')\n')
+PY
+cmake -S "$attempt" -B "$attempt/cmake" -DCMAKE_CXX_COMPILER="$cxx" \
+  2>&1 | tee "$attempt/configure.log"
+cmake --build "$attempt/cmake" --parallel "${CPPHDL_BUILD_JOBS:-1}" \
+  2>&1 | tee "$attempt/compile.log"
+test -x "$attempt/cmake/cpphdl-rocket64-graph-sim"
+ln -sfn "$attempt/cmake/cpphdl-rocket64-graph-sim" "$build_dir/cpphdl-rocket64-graph-sim"
+printf '%s\n' "$attempt" > "$build_dir/latest-success"
+echo "Native graph Rocket simulator: $build_dir/cpphdl-rocket64-graph-sim"
