include("${TOOLCHAIN}")
file(MAKE_DIRECTORY "${WORK}")
set(source "${ROOT}/${SOURCE}")
if(FLOW STREQUAL "native")
    execute_process(COMMAND "${CXX}" ${HLS_CXX_FLAGS} "-I${ROOT}/include" "${source}"
        ${HLS_LINK_FLAGS} -o "${WORK}/native" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(binary "${WORK}/native")
else()
    file(REMOVE_RECURSE "${WORK}/generated" "${WORK}/obj")
    if(FLOW STREQUAL "gates")
        set(options --synth --top ${TOP} --module ${TOP} --output "${WORK}/generated" --cxx "${CXX}")
    else()
        set(options --generated-dir "${WORK}/generated")
    endif()
    execute_process(COMMAND "${CPPHDL}" ${options} "${source}" -- "-I${ROOT}/include" ${HLS_PARSE_FLAGS}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${WORK}/conversion.log" "${output}\n${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "RAM conversion failed: ${output}\n${error}")
    endif()
    if(FLOW STREQUAL "gates")
        set(sources "${WORK}/generated/gates.v")
    else()
        file(GLOB packages "${WORK}/generated/*_pkg.sv")
        file(GLOB sources "${WORK}/generated/*.sv")
        list(REMOVE_ITEM sources ${packages})
        list(PREPEND sources ${packages})
        if(TOP STREQUAL "BankedRamTop")
            file(READ "${WORK}/generated/${TOP}.sv" rtl)
            if(NOT rtl MATCHES "begin : _work" OR rtl MATCHES "task[^\n]*_work")
                message(FATAL_ERROR "Clocked RAM accesses were not inlined")
            endif()
        endif()
    endif()
    string(JOIN " " flags ${HLS_CXX_FLAGS} "-I${ROOT}/include" -DVERILATOR)
    if(FLOW STREQUAL "gates")
        string(APPEND flags " -DSYNTH_GATES")
    endif()
    string(JOIN " " links ${HLS_LINK_FLAGS})
    execute_process(COMMAND "${VERILATOR}" --cc --exe --build -j 2 -Wno-fatal --top-module ${TOP}
        --Mdir "${WORK}/obj" -CFLAGS "${flags}" -LDFLAGS "${links}" ${sources} "${source}"
        -MAKEFLAGS "CXX=${CXX} LINK=${CXX}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${WORK}/build.log" "${output}\n${error}")
    if(error MATCHES "%Warning-(LATCH|MULTIDRIVEN)")
        message(FATAL_ERROR "RAM warning: ${error}")
    endif()
    set(binary "${WORK}/obj/V${TOP}")
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "RAM ${FLOW} build failed: ${output}\n${error}")
endif()
execute_process(COMMAND "${binary}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "RAM ${FLOW} simulation failed (${result}): ${output}\n${error}")
endif()
message(STATUS "${output}")
