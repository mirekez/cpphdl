include("${TOOLCHAIN}")
file(MAKE_DIRECTORY "${WORK}")
set(source "${ROOT}/hls/examples/openmp/${EXAMPLE}.cpp")
if(FLOW STREQUAL "native")
    if(NATIVE_CXX)
        set(CXX "${NATIVE_CXX}")
        set(HLS_CXX_FLAGS -std=c++17 -fno-strict-aliasing)
        set(HLS_LINK_FLAGS)
    endif()
    execute_process(COMMAND "${CXX}" ${HLS_CXX_FLAGS} -O2 -fopenmp "-I${ROOT}/include"
        "${source}" ${HLS_LINK_FLAGS} -o "${WORK}/native"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "OpenMP native build failed:\n${output}\n${error}")
    endif()
    set(binary "${WORK}/native")
else()
    file(REMOVE_RECURSE "${WORK}/generated" "${WORK}/obj_dir" "${WORK}/synth")
    set(latency 3)
    set(options --generated-dir "${WORK}/generated")
    if(FLOW STREQUAL "gates")
        set(options --synth --top PipelineTop --module PipelineTop --output "${WORK}/synth"
            --cxx "${CXX}" --retiming fit_pipeline_retiming --clock-period-ns 2.0)
    endif()
    execute_process(COMMAND "${CPPHDL}" ${options} "${source}" -- "-I${ROOT}/include"
        -fopenmp ${HLS_PARSE_FLAGS}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${WORK}/conversion.log" "${output}\n${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "OpenMP conversion failed:\n${output}\n${error}")
    endif()
    if(FLOW STREQUAL "gates")
        set(sources "${WORK}/synth/gates.v")
        file(READ "${WORK}/synth/timing.json" timing)
        string(JSON latency GET "${timing}" streaming_regions 0 latency)
        string(JSON interval GET "${timing}" streaming_regions 0 initiation_interval)
        string(JSON target_met GET "${timing}" rules 0 target_met)
        string(JSON worst GET "${timing}" worst_ns)
        if(NOT interval EQUAL 1 OR latency LESS 3 OR NOT target_met OR worst GREATER 2.000001)
            message(FATAL_ERROR "Expected a retimed II=1 pipeline meeting its estimated period: ${timing}")
        endif()
        if(EXAMPLE STREQUAL "ParallelFor" AND NOT latency GREATER 3)
            message(FATAL_ERROR "The arithmetic-lane regression must exercise added timing stages: ${timing}")
        endif()
    else()
        file(GLOB sources "${WORK}/generated/*.sv")
        file(GLOB packages "${WORK}/generated/*_pkg.sv")
        list(REMOVE_ITEM sources ${packages})
        list(PREPEND sources ${packages})
        file(GLOB workers "${WORK}/generated/*ClockedPipeline*.sv")
        list(LENGTH workers count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Expected one parallel pipeline worker")
        endif()
        file(READ "${workers}" worker)
        if(NOT worker MATCHES "pipelined_logic: II=1" OR worker MATCHES "heap_next|booting")
            message(FATAL_ERROR "OpenMP lanes became a delayed FSM")
        endif()
    endif()
    string(JOIN " " flags ${HLS_CXX_FLAGS} -O2 -fopenmp "-I${ROOT}/include"
        -DVERILATOR "-DPIPELINE_LATENCY=${latency}")
    string(JOIN " " links ${HLS_LINK_FLAGS} -fopenmp)
    set(verilator_options)
    if(FLOW STREQUAL "gates")
        execute_process(COMMAND "${VERILATOR}" --version OUTPUT_VARIABLE verilator_version
            COMMAND_ERROR_IS_FATAL ANY)
        # 5.050's DFG pass can fold (~a) ^ (~(a ^ b)) to zero in a shared
        # gate cone. RowContexts exposes this under randomized backpressure.
        if(verilator_version MATCHES "^Verilator 5\\.050 ")
            list(APPEND verilator_options -fno-dfg)
            message(STATUS "Verilator 5.050: disabling incorrect DFG optimization for gate simulation")
        endif()
    endif()
    execute_process(COMMAND "${VERILATOR}" ${verilator_options} --cc --exe --build -j 2 --top-module PipelineTop
        --prefix VPipelineTop --Mdir "${WORK}/obj_dir" -Wno-fatal
        -CFLAGS "${flags}" -LDFLAGS "${links}" ${sources} "${source}"
        -MAKEFLAGS "CXX=${CXX} LINK=${CXX}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${WORK}/build.log" "${output}\n${error}")
    if(NOT result EQUAL 0 OR error MATCHES "%Warning-(LATCH|MULTIDRIVEN)")
        message(FATAL_ERROR "OpenMP RTL build failed:\n${output}\n${error}")
    endif()
    set(binary "${WORK}/obj_dir/VPipelineTop")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env OMP_NUM_THREADS=2 OMP_DYNAMIC=FALSE "${binary}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${WORK}/simulation.log" "${output}\n${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "OpenMP ${FLOW} simulation failed:\n${output}\n${error}")
endif()
message(STATUS "${output}")
