file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(REMOVE "${OUTPUT_DIR}/report.json")
execute_process(COMMAND "${EXECUTABLE}" "${OUTPUT_DIR}"
  RESULT_VARIABLE actual_exit OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${actual_exit}" STREQUAL "${EXPECTED_EXIT}")
  message(FATAL_ERROR "${EXECUTABLE}: expected exit ${EXPECTED_EXIT}, got ${actual_exit}\n${output}\n${error}")
endif()
if(NOT EXISTS "${OUTPUT_DIR}/report.json")
  message(FATAL_ERROR "${EXECUTABLE}: missing report.json\n${output}\n${error}")
endif()
file(READ "${OUTPUT_DIR}/report.json" report)
string(JSON actual_status GET "${report}" status)
if(NOT "${actual_status}" STREQUAL "${EXPECTED_STATUS}")
  message(FATAL_ERROR "${EXECUTABLE}: expected status ${EXPECTED_STATUS}, got ${actual_status}\n${output}\n${error}")
endif()
