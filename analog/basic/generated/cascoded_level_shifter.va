        // device 5, IC cascoded_level_shifter, analog/basic/cascoded_level_shifter.hpp:61
        I(cpphdl_n23, cpphdl_n11) <+ cpphdl_channel(V(BIAS, cpphdl_n11), V(cpphdl_n23, cpphdl_n11), 0.014999999999999999, 0.69999999999999996, 1.0);
        // device 6, IC cascoded_level_shifter, analog/basic/cascoded_level_shifter.hpp:62
        I(cpphdl_n19, cpphdl_n12) <+ cpphdl_channel(V(BIAS, cpphdl_n12), V(cpphdl_n19, cpphdl_n12), 0.014999999999999999, 0.69999999999999996, 1.0);
        // device 7, IC cascoded_level_shifter, analog/basic/cascoded_level_shifter.hpp:63
        I(cpphdl_n11, Vss) <+ cpphdl_channel(V(cpphdl_n16, Vss), V(cpphdl_n11, Vss), 0.059999999999999998, 0.5, 1.0);
        // device 8, IC cascoded_level_shifter, analog/basic/cascoded_level_shifter.hpp:64
        I(cpphdl_n12, Vss) <+ cpphdl_channel(V(A, Vss), V(cpphdl_n12, Vss), 0.059999999999999998, 0.5, 1.0);
