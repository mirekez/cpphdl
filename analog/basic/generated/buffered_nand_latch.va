        // device 11, IC IC4, analog/basic/inverter.hpp:11
        I(cpphdl_n38, Vdd) <+ cpphdl_channel(V(cpphdl_n22, Vdd), V(cpphdl_n38, Vdd), 0.0040000000000000001, 0.69999999999999996, -1.0);
