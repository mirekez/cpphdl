        // device 13, IC cascode_opamp, analog/basic/cascode_opamp.hpp:42
        I(cpphdl_n14, Vss) <+ 4e-14 * ddt(V(cpphdl_n14, Vss)); // Bench initial voltage = 0.0 V.
