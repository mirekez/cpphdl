module Example_pll_refined(n0, n19, n22, n25, n29, n31, n34, n35, n37, n40, n42, n49, n52, n55, n58, n59, n61, n63, n64, cpphdl_bit0);
    inout n0, n19, n22, n25, n29, n31, n34, n35, n37, n40, n42, n49, n52, n55, n58, n59, n61, n63, n64, cpphdl_bit0;
    electrical n0, n19, n22, n25, n29, n31, n34, n35, n37, n40, n42, n49, n52, n55, n58, n59, n61, n63, n64, cpphdl_bit0;

    // Square-law channel, including reverse conduction. This is not a BSIM model.
    analog function real cpphdl_channel;
        input vgs, vds, beta, threshold, polarity;
        real vgs, vds, beta, threshold, polarity;
        real gate, drain, direction, overdrive, current;
        begin
            gate = polarity * vgs;
            drain = polarity * vds;
            direction = 1.0;
            if (drain < 0.0) begin
                gate = gate - drain;
                drain = -drain;
                direction = -1.0;
            end
            overdrive = gate - threshold;
            current = 0.0;
            if (overdrive > 0.0) begin
                if (drain < overdrive)
                    current = beta * (overdrive * drain - drain * drain / 2.0);
                else
                    current = beta * overdrive * overdrive / 2.0;
            end
            cpphdl_channel = polarity * direction * current;
        end
    endfunction

