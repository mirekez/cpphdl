file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/coarse" "${WORK}/fine")
function(run_stage name directory)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  file(WRITE "${WORK}/${name}.log" "${output}\n${error}")
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${CASE}: ${name} failed (${result}); see ${WORK}/${name}.log")
  endif()
endfunction()
run_stage(openvaf-version "${WORK}" "${OPENVAF}" --version)
run_stage(ngspice-version "${WORK}" "${NGSPICE}" --version)
run_stage(cpp-coarse "${WORK}" "${BENCH}" "${CASE}" "${WORK}/coarse" 1)
run_stage(cpp-fine "${WORK}" "${BENCH}" "${CASE}" "${WORK}/fine" 2)
if(INJECT_RESISTOR_FAULT)
  file(READ "${WORK}/fine/design.va" original)
  string(REPLACE "/ 1000.0;" "/ 2000.0;" corrupted "${original}")
  if(corrupted STREQUAL original)
    message(FATAL_ERROR "fault injection did not change the generated resistor")
  endif()
  file(WRITE "${WORK}/fine/design.va" "${corrupted}")
endif()
# Compile the actual generated model. A SPICE-only fallback must never masquerade as a Verilog-A test.
run_stage(openvaf "${WORK}/fine" "${OPENVAF}" design.va -o design.osdi)
run_stage(ngspice "${WORK}/fine" "${NGSPICE}" -n -b bench.cir)
if(NOT EXISTS "${WORK}/fine/spice.dat")
  message(FATAL_ERROR "${CASE}: ngspice produced no waveform; see ${WORK}/ngspice.log")
endif()
if(INJECT_RESISTOR_FAULT)
  execute_process(COMMAND "${PYTHON}" "${COMPARE}" "${CASE}" "${WORK}/coarse" "${WORK}/fine"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  file(WRITE "${WORK}/compare.log" "${output}\n${error}")
  if(NOT "${result}" STREQUAL "1")
    message(FATAL_ERROR "fault must cause a quantitative mismatch, not a crash or missing evidence: ${result}")
  endif()
  file(READ "${WORK}/fine/comparison.json" report)
  string(JSON status GET "${report}" status)
  if(NOT status STREQUAL "failed")
    message(FATAL_ERROR "altered Verilog-A resistor escaped comparison")
  endif()
else()
  run_stage(compare "${WORK}" "${PYTHON}" "${COMPARE}" "${CASE}" "${WORK}/coarse" "${WORK}/fine")
endif()
