        // device 2, IC OneGBiasedMDIInputNetwork, analog/1G/biased_mdi_input_network.hpp:21
        I(VCM, PLUS) <+ V(VCM, PLUS) / 150.0;
        // device 3, IC OneGBiasedMDIInputNetwork, analog/1G/biased_mdi_input_network.hpp:22
        I(VCM, MINUS) <+ V(VCM, MINUS) / 150.0;
    end
endmodule
