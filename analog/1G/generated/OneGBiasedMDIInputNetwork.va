`include "disciplines.vams"

module OneGBiasedMDIInputNetwork(Vdd, Vss, P, N, VCM, PLUS, MINUS);
    inout Vdd, Vss, P, N, VCM, PLUS, MINUS;
    electrical Vdd, Vss, P, N, VCM, PLUS, MINUS;

    analog begin
        // device 0, IC OneGBiasedMDIInputNetwork, analog/1G/biased_mdi_input_network.hpp:19
