        // device 8, IC IC1, analog/1G/IHPSG13G2/biased_driver.hpp:31
        I(cpphdl_n30, Vdd) <+ cpphdl_channel(V(TRIM_N3, Vdd), V(cpphdl_n30, Vdd), 0.02, 0.69999999999999996, -1.0);
        // device 9, IC IC1, analog/1G/IHPSG13G2/biased_driver.hpp:32
        I(cpphdl_n30, cpphdl_n20) <+ V(cpphdl_n30, cpphdl_n20) / 32000.0;
        // device 10, IC IC1, analog/1G/IHPSG13G2/biased_driver.hpp:31
        I(cpphdl_n31, Vdd) <+ cpphdl_channel(V(TRIM_N4, Vdd), V(cpphdl_n31, Vdd), 0.02, 0.69999999999999996, -1.0);
        // device 11, IC IC1, analog/1G/IHPSG13G2/biased_driver.hpp:32
