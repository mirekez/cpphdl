// SIMULATION APPROXIMATION: controlled conductances are not physical MOS devices.
// Generated from elaborated C++HDL IC purposes; all contributions coexist.
// Capacitor initialization belongs to the host analysis; declared initial voltages appear below.
`include "disciplines.vams"

module OneGIHPReceiveCommonReference(Vdd, Vss, OUT);
    inout Vdd, Vss, OUT;
    electrical Vdd, Vss, OUT;
    electrical cpphdl_n31;
    electrical cpphdl_n32;
    electrical cpphdl_n33;
    electrical cpphdl_n34;
    electrical cpphdl_n35;
    electrical cpphdl_n36;
    electrical cpphdl_n37;
    electrical cpphdl_n38;
    electrical cpphdl_n39;
    electrical cpphdl_n40;
    electrical cpphdl_n41;

    // Square-law channel, including reverse conduction. This is not a BSIM model.
    analog function real cpphdl_channel;
        input vgs, vds, beta, threshold, polarity;
        real vgs, vds, beta, threshold, polarity;
        real gate, drain, direction, overdrive, current;
        begin
            gate = polarity * vgs;
            drain = polarity * vds;
            direction = 1.0;
            if (drain < 0.0) begin
                gate = gate - drain;
                drain = -drain;
                direction = -1.0;
            end
            overdrive = gate - threshold;
            current = 0.0;
            if (overdrive > 0.0) begin
                if (drain < overdrive)
                    current = beta * (overdrive * drain - drain * drain / 2.0);
                else
                    current = beta * overdrive * overdrive / 2.0;
            end
            cpphdl_channel = polarity * direction * current;
        end
    endfunction

    analog begin
        // device 0, IC IC1, analog/basic/resistor_divider.hpp:15
        I(Vdd, cpphdl_n31) <+ V(Vdd, cpphdl_n31) / 10000.0;
        // device 1, IC IC1, analog/basic/resistor_divider.hpp:16
        I(cpphdl_n31, Vss) <+ V(cpphdl_n31, Vss) / 12000.0;
