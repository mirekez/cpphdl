        // device 9, IC OneGIHPReceiveCommonReference, analog/1G/IHPSG13G2/receive_common_reference.hpp:36
        I(Vdd, cpphdl_n35) <+ V(Vdd, cpphdl_n35) / 2500.0;
        // device 10, IC OneGIHPReceiveCommonReference, analog/1G/IHPSG13G2/receive_common_reference.hpp:37
        I(cpphdl_n35, Vss) <+ cpphdl_channel(V(cpphdl_n35, Vss), V(cpphdl_n35, Vss), 0.029999999999999999, 0.69999999999999996, 1.0);
        // device 11, IC OneGIHPReceiveCommonReference, analog/1G/IHPSG13G2/receive_common_reference.hpp:38
        I(cpphdl_n35, Vss) <+ 9.9999999999999994e-12 * ddt(V(cpphdl_n35, Vss)); // Bench initial voltage = 0.0 V.
        // device 12, IC IC5, analog/basic/cascode_ota.hpp:29
        I(cpphdl_n36, cpphdl_n41) <+ cpphdl_channel(V(OUT, cpphdl_n41), V(cpphdl_n36, cpphdl_n41), 0.029999999999999999, 0.69999999999999996, 1.0);
        // device 13, IC IC5, analog/basic/cascode_ota.hpp:30
