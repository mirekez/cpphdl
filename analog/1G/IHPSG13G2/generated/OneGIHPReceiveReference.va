        // device 10, IC OneGIHPReceiveReference, analog/1G/IHPSG13G2/receive_reference.hpp:40
        I(cpphdl_n33, Vss) <+ cpphdl_channel(V(cpphdl_n33, Vss), V(cpphdl_n33, Vss), 0.029999999999999999, 0.69999999999999996, 1.0);
        // device 11, IC OneGIHPReceiveReference, analog/1G/IHPSG13G2/receive_reference.hpp:41
        I(cpphdl_n33, Vss) <+ 9.9999999999999994e-12 * ddt(V(cpphdl_n33, Vss)); // Bench initial voltage = 0.0 V.
        // device 12, IC IC5, analog/basic/cascode_ota.hpp:29
        I(cpphdl_n34, cpphdl_n39) <+ cpphdl_channel(V(cpphdl_n28, cpphdl_n39), V(cpphdl_n34, cpphdl_n39), 0.029999999999999999, 0.69999999999999996, 1.0);
        // device 13, IC IC5, analog/basic/cascode_ota.hpp:30
