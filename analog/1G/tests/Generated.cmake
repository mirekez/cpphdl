file(REMOVE_RECURSE "${WORK}")
execute_process(COMMAND "${GENERATOR}" "${ROOT}" "${WORK}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "1G module generation failed")
endif()
file(GLOB expected RELATIVE "${SOURCE}" "${SOURCE}/generated/*.va" "${SOURCE}/IHPSG13G2/generated/*.va")
file(GLOB actual RELATIVE "${WORK}" "${WORK}/generated/*.va" "${WORK}/IHPSG13G2/generated/*.va")
if(NOT "${expected}" STREQUAL "${actual}")
  message(FATAL_ERROR "1G generated module catalog differs; run generate-1g-veriloga")
endif()
foreach(file IN LISTS expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${SOURCE}/${file}" "${WORK}/${file}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "stale generated module ${file}; run generate-1g-veriloga")
  endif()
  if(OPENVAF)
    get_filename_component(name "${file}" NAME_WE)
    file(READ "${WORK}/${file}" model)
    string(REGEX MATCHALL "// device [0-9]+, IC " contributions "${model}")
    list(LENGTH contributions contribution_count)
    if(contribution_count GREATER_EQUAL 1000)
      # Keep the same connected equations while bounding each compiler unit.
      set(directory "${WORK}/${name}-hierarchy")
      execute_process(COMMAND "${DRIVER}" --verilog-a --partition "${WORK}/${file}" --output "${directory}"
        RESULT_VARIABLE status OUTPUT_VARIABLE partition_output ERROR_VARIABLE error TIMEOUT 60)
      if(NOT status EQUAL 0)
        message(FATAL_ERROR "${file} partition failed: ${partition_output}${error}")
      endif()
      file(GLOB compile_sources "${directory}/AnalogLeaf_*.va")
      if(NOT compile_sources)
        message(FATAL_ERROR "${file} partition produced no compiler units")
      endif()
    else()
      set(compile_sources "${WORK}/${file}")
    endif()
    foreach(compile_source IN LISTS compile_sources)
      get_filename_component(unit "${compile_source}" NAME_WE)
      get_filename_component(directory "${compile_source}" DIRECTORY)
      execute_process(COMMAND "${PYTHON}" "${SOURCE}/../pdk/1G_repeater_IHPSG13G2/tool_process.py" --exclusive --
        "${OPENVAF}" "${compile_source}" -o "${directory}/${unit}.osdi"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 600)
      if(NOT status EQUAL 0)
        message(FATAL_ERROR "${file}/${unit} compilation failed: ${error}")
      endif()
    endforeach()
  endif()
endforeach()
