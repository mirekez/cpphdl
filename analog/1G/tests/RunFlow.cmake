file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT REFINEMENT)
  set(REFINEMENT 1)
endif()
function(stage name)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 560)
  file(WRITE "${WORK}/${name}.log" "${output}\n${error}")
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${CASE}/${FLOW}: ${name} failed: ${result}\n${output}\n${error}")
  endif()
endfunction()
if(FLOW STREQUAL "cpp")
  stage(simulate "${BENCH}" "${CASE}" "${WORK}" run "${REFINEMENT}")
else()
  stage(export "${BENCH}" "${CASE}" "${WORK}" export "${REFINEMENT}")
  stage(compile "${OPENVAF}" design.va -o design.osdi)
  stage(simulate "${NGSPICE}" -n -b bench.cir)
endif()
set(check_args "${PYTHON}" "${CHECKER}" "${FLOW}" "${WORK}" --dsp "${DSP}")
if(PCS)
  list(APPEND check_args --pcs "${PCS}")
endif()
if(FIXED_DSP)
  list(APPEND check_args --fixed-dsp "${FIXED_DSP}")
endif()
stage(check ${check_args})
