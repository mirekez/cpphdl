file(REMOVE_RECURSE "${WORK}")
execute_process(COMMAND "${GENERATOR}" "${ROOT}" "${WORK}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "10G module generation failed")
endif()
if(NOT DEFINED CATALOG)
  set(CATALOG "${SOURCE}")
endif()
file(GLOB expected RELATIVE "${CATALOG}" "${CATALOG}/generated/*.va")
file(GLOB actual RELATIVE "${WORK}" "${WORK}/generated/*.va")
if(NOT "${expected}" STREQUAL "${actual}")
  message(FATAL_ERROR "10G generated module catalog differs; run generate-10g-veriloga")
endif()
foreach(file IN LISTS expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${CATALOG}/${file}" "${WORK}/${file}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "stale generated module ${file}; run generate-10g-veriloga")
  endif()
  if(OPENVAF)
    get_filename_component(name "${file}" NAME_WE)
    execute_process(COMMAND "${OPENVAF}" "${WORK}/${file}" -o "${WORK}/${name}.osdi"
      RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 60)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "${file} compilation failed: ${error}")
    endif()
  endif()
endforeach()
