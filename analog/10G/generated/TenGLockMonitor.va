        // device 24, IC IC3, analog/basic/gm_stage.hpp:30
        I(cpphdl_n34, Vdd) <+ max(0.0, V(cpphdl_n34, Vdd) - 0.0) / 0.10000000000000001 + V(cpphdl_n34, Vdd) / 1000000000.0;
        // device 25, IC IC3, analog/basic/gm_stage.hpp:31
        I(Vss, cpphdl_n34) <+ max(0.0, V(Vss, cpphdl_n34) - 0.0) / 0.10000000000000001 + V(Vss, cpphdl_n34) / 1000000000.0;
        // device 26, IC IC4, analog/basic/sim_clocked_storage.hpp:63
        I(cpphdl_n35, Vss) <+ (1.0 - min(1.0, max(0.0, (V(cpphdl_n34, Vss) - 0.25) / 0.20000000000000001))) * V(cpphdl_n35, Vss) / 25.0; // sim_buffered_track
        // device 27, IC IC4, analog/basic/sim_clocked_storage.hpp:64
        I(cpphdl_n35, Vss) <+ min(1.0, max(0.0, (V(cpphdl_n34, Vss) - 0.75) / 0.19999999999999996)) * V(cpphdl_n35, cpphdl_n33) / 25.0; // sim_buffered_track
        // device 28, IC IC4, analog/basic/sim_clocked_storage.hpp:65
        I(cpphdl_n35, Vss) <+ 2.0000000000000002e-15 * ddt(V(cpphdl_n35, Vss)); // Bench initial voltage = 0.0 V.
        // device 29, IC IC4, analog/basic/sim_clocked_storage.hpp:66
        I(cpphdl_n35, Vss) <+ V(cpphdl_n35, Vss) / 1000000000.0;
        // device 30, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:56
