// SIMULATION APPROXIMATION: controlled conductances are not physical MOS devices.
// Generated from elaborated C++HDL IC purposes; all contributions coexist.
// Capacitor initialization belongs to the host analysis; declared initial voltages appear below.
`include "disciplines.vams"

module TenGLockMonitor(Vdd, Vss, ERROR, REFERENCE, VCM, LOCK);
    inout Vdd, Vss, ERROR, REFERENCE, VCM, LOCK;
    electrical Vdd, Vss, ERROR, REFERENCE, VCM, LOCK;
    electrical cpphdl_n14;
    electrical cpphdl_n16;
    electrical cpphdl_n17;
    electrical cpphdl_n21;
    electrical cpphdl_n26;
    electrical cpphdl_n27;
    electrical cpphdl_n33;
    electrical cpphdl_n34;
    electrical cpphdl_n35;

    analog begin
        // device 0, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:22
        I(Vss, cpphdl_n14) <+ V(Vss, cpphdl_n14) / 1000.0;
        // device 1, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:23
        I(cpphdl_n14, Vss) <+ (-0.001) * V(ERROR, REFERENCE);
        // device 2, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:24
        I(cpphdl_n14, Vss) <+ 7.757575757575757e-13 * ddt(V(cpphdl_n14, Vss)); // Bench initial voltage = 0.0 V.
        // device 3, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:25
        I(REFERENCE, cpphdl_n26) <+ V(REFERENCE, cpphdl_n26) / 1000.0;
