        // device 5, IC IC1, analog/basic/bridge_rectifier.hpp:14
        I(cpphdl_n14, cpphdl_n16) <+ max(0.0, V(cpphdl_n14, cpphdl_n16) - 0.0) / 10.0 + V(cpphdl_n14, cpphdl_n16) / 1000000000.0;
        // device 6, IC IC1, analog/basic/bridge_rectifier.hpp:15
        I(Vss, cpphdl_n16) <+ max(0.0, V(Vss, cpphdl_n16) - 0.0) / 10.0 + V(Vss, cpphdl_n16) / 1000000000.0;
        // device 7, IC IC1, analog/basic/bridge_rectifier.hpp:16
        I(cpphdl_n17, cpphdl_n14) <+ max(0.0, V(cpphdl_n17, cpphdl_n14) - 0.0) / 10.0 + V(cpphdl_n17, cpphdl_n14) / 1000000000.0;
        // device 8, IC IC1, analog/basic/bridge_rectifier.hpp:17
        I(cpphdl_n17, Vss) <+ max(0.0, V(cpphdl_n17, Vss) - 0.0) / 10.0 + V(cpphdl_n17, Vss) / 1000000000.0;
        // device 9, IC IC1, analog/basic/bridge_rectifier.hpp:18
        I(cpphdl_n16, cpphdl_n17) <+ V(cpphdl_n16, cpphdl_n17) / 10000.0;
        // device 10, IC IC1, analog/basic/bridge_rectifier.hpp:19
        I(cpphdl_n17, Vss) <+ V(cpphdl_n17, Vss) / 1000000000.0;
        // device 11, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:32
        I(Vss, cpphdl_n21) <+ V(Vss, cpphdl_n21) / 1000.0;
        // device 12, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:33
        I(cpphdl_n21, Vss) <+ (-0.001) * V(cpphdl_n16, cpphdl_n17);
        // device 13, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:34
        I(cpphdl_n21, Vss) <+ 3.8787878787878785e-13 * ddt(V(cpphdl_n21, Vss)); // Bench initial voltage = 0.0 V.
        // device 14, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:35
        I(VCM, cpphdl_n27) <+ V(VCM, cpphdl_n27) / 100000.0;
        // device 15, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:36
        I(cpphdl_n27, Vss) <+ V(cpphdl_n27, Vss) / 10000.0;
        // device 16, IC IC2, analog/basic/gm_stage.hpp:18
        I(VCM, cpphdl_n33) <+ V(VCM, cpphdl_n33) / 1000.0;
        // device 17, IC IC2, analog/basic/gm_stage.hpp:19
        I(cpphdl_n33, VCM) <+ (-0.10000000000000001) * V(cpphdl_n27, cpphdl_n21);
        // device 18, IC IC2, analog/basic/gm_stage.hpp:20
        I(cpphdl_n33, VCM) <+ 1.0000000000000001e-15 * ddt(V(cpphdl_n33, VCM)); // Bench initial voltage = 0.0 V.
        // device 19, IC IC2, analog/basic/gm_stage.hpp:30
        I(cpphdl_n33, Vdd) <+ max(0.0, V(cpphdl_n33, Vdd) - 0.0) / 0.10000000000000001 + V(cpphdl_n33, Vdd) / 1000000000.0;
        // device 20, IC IC2, analog/basic/gm_stage.hpp:31
        I(Vss, cpphdl_n33) <+ max(0.0, V(Vss, cpphdl_n33) - 0.0) / 0.10000000000000001 + V(Vss, cpphdl_n33) / 1000000000.0;
        // device 21, IC IC3, analog/basic/gm_stage.hpp:18
        I(VCM, cpphdl_n34) <+ V(VCM, cpphdl_n34) / 1000.0;
        // device 22, IC IC3, analog/basic/gm_stage.hpp:19
        I(cpphdl_n34, VCM) <+ (-0.10000000000000001) * V(cpphdl_n26, cpphdl_n27);
        // device 23, IC IC3, analog/basic/gm_stage.hpp:20
