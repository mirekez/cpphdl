        // device 31, IC TenGLockMonitor, analog/10G/lock_monitor.hpp:57
        I(LOCK, Vss) <+ 3.8787878787878785e-13 * ddt(V(LOCK, Vss)); // Bench initial voltage = 0.0 V.
